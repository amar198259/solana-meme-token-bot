# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Solana RPC
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_URL_DEVNET=https://api.devnet.solana.com

# Wallet Private Key (Base58 encoded)
WALLET_PRIVATE_KEY=your_wallet_private_key_here

# Database
DATABASE_URL=sqlite:./bot.db

# Trading Settings
SLIPPAGE_PERCENTAGE=2
MIN_TOKEN_AMOUNT=1000
MAX_TOKEN_AMOUNT=1000000

# Minimum Buy Amount (0.05 SOL)
MIN_BUY_AMOUNT=0.05
DEFAULT_BUY_AMOUNT=0.05

# Network
NETWORK=mainnet
# استخدم devnet للاختبار

# Auto Sell Settings
AUTO_SELL_PROFIT_PERCENT=200
AUTO_SELL_ENABLED=true

# Liquidity Check
MIN_LIQUIDITY_GOOD=50000
MIN_LIQUIDITY_SAFE=10000
CHECK_LIQUIDITY_BEFORE_BUY=true
